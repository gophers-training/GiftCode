{
    "swagger": "2.0",
    "info": {
        "description": "This is the API documentation for the Wallet Manager service.",
        "title": "Wallet Manager API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "email": "support@example.com"
        },
        "license": {
